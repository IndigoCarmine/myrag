# RAG System Environment Variables

# Service URLs
GATEWAY_URL=http://localhost:8000
RETRIEVAL_URL=http://localhost:8001
INGESTION_URL=http://localhost:8002
EMBEDDING_URL=http://localhost:8003

# Infrastructure URLs
QDRANT_URL=http://localhost:6333
GROBID_URL=http://localhost:8070
OLLAMA_URL=http://localhost:11434

# Ollama Configuration
# Available models: deepseek-r1:8b, gemma3:4b, gemma3:1b, llama3
OLLAMA_MODEL=gemma3:4b

# Embedding Model
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Qdrant Collection Name
QDRANT_COLLECTION=papers
